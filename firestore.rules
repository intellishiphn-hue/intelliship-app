rules_version = '2';

// Reglas base: nada es publico. Todo requiere sesion iniciada (Firebase Auth).
// Se iran afinando por coleccion (roles admin/coordinador/empleado) a medida
// que migremos cada modulo (RRHH, Carga China, Bodega, Guias, Buzon).
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /empleados/{empleadoId} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado();
    }
  }
}
