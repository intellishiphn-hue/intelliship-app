rules_version = '2';

// Reglas base: nada es publico. Todo requiere sesion iniciada (Firebase Auth).
// Se iran afinando modulo por modulo (RRHH, Carga China, Bodega, Guias, Buzon).
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function miRol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return estaAutenticado() && miRol() == 'admin';
    }

    function esCoordinadorOAdmin() {
      return estaAutenticado() && (miRol() == 'admin' || miRol() == 'coordinador');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Rol de cada usuario (admin/coordinador/empleado). Cualquier usuario
    // autenticado puede leer roles (se necesita para el menu), pero solo un
    // admin puede crear o cambiar roles.
    match /usuarios/{uid} {
      allow read: if estaAutenticado();
      allow create: if esAdmin() || (estaAutenticado() && request.auth.uid == uid);
      allow update: if esAdmin();
    }

    match /empleados/{empleadoId} {
      allow read: if estaAutenticado();
      // Cualquier autenticado puede crear/editar (dar de alta, corregir datos,
      // marcar activo/inactivo). Borrar definitivamente el registro es solo
      // para admin -- para "ya no trabaja aqui" se usa el campo activo:false,
      // no delete.
      allow create, update: if estaAutenticado();
      allow delete: if esAdmin();

      // Datos sensibles (salario, etc.) solo los puede leer/escribir un
      // admin. Coordinadores y empleados no tienen acceso a esta subcoleccion.
      match /confidencial/{doc} {
        allow read, write: if esAdmin();
      }
    }

    // Vacaciones / permisos / faltas. Las registra directamente el admin
    // (no hay flujo de aprobacion); cualquier usuario autenticado puede
    // leerlas (mas adelante, cuando exista login de empleado, se limitara
    // a que cada quien vea solo lo suyo).
    match /vacaciones/{registroId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Pagos de nomina (quincenales). Mismo criterio que vacaciones.
    match /pagos/{pagoId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Marcaciones de asistencia (entrada/salida). Cualquier usuario
    // autenticado puede crear las suyas (reloj marcador de autoservicio);
    // solo un admin puede editarlas o borrarlas.
    match /asistencia/{marcaId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado();
      allow update, delete: if esAdmin();
    }

    // Modulos de envios (Guias, Bodega, Carga China). Coordinador tiene el
    // mismo acceso que admin para operar el dia a dia; empleado solo lee.
    // Borrar definitivamente sigue siendo solo para admin.
    match /bodega/{id} {
      allow read: if estaAutenticado();
      allow create, update: if esCoordinadorOAdmin();
      allow delete: if esAdmin();
    }

    match /guiasNacionales/{id} {
      allow read: if estaAutenticado();
      allow create, update: if esCoordinadorOAdmin();
      allow delete: if esAdmin();
    }

    match /cargoExpreso/{id} {
      allow read: if estaAutenticado();
      allow create, update: if esCoordinadorOAdmin();
      allow delete: if esAdmin();
    }

    match /chinaClientes/{id} {
      allow read: if estaAutenticado();
      allow create, update: if esCoordinadorOAdmin();
      allow delete: if esAdmin();
    }

    match /chinaContenedores/{id} {
      allow read: if estaAutenticado();
      allow create, update: if esCoordinadorOAdmin();
      allow delete: if esAdmin();
    }

    match /chinaRecibos/{id} {
      allow read: if estaAutenticado();
      allow create, update: if esCoordinadorOAdmin();
      allow delete: if esAdmin();
    }

    // Documentos del expediente de cada empleado (identidad, contrato,
    // etc.). El archivo en si vive en Storage (documentos/{empleadoId}/...);
    // esto es solo el metadato. Igual criterio que empleados: cualquier
    // autenticado puede subir/editar, borrar definitivamente es solo admin.
    match /documentos/{id} {
      allow read: if estaAutenticado();
      allow create, update: if estaAutenticado();
      allow delete: if esAdmin();
    }

    // Bitacora de los mensajes de WhatsApp que mandan las Cloud Functions
    // (recibo de pago, cambio de estado de envio). Las funciones escriben
    // con el SDK de Admin (no pasan por estas reglas); esto solo controla
    // quien puede CONSULTAR la bitacora desde el panel.
    match /waLogs/{id} {
      allow read: if esCoordinadorOAdmin();
      allow write: if false;
    }

    // Buzon Intelliship: cualquier autenticado puede enviar un reporte
    // (create), pero solo admin/coordinador pueden leer la bandeja, marcar
    // estado o agregar nota interna. Borrar definitivamente es solo admin.
    match /buzon/{id} {
      allow read: if esCoordinadorOAdmin();
      allow create: if estaAutenticado();
      allow update: if esCoordinadorOAdmin();
      allow delete: if esAdmin();
    }
  }
}
