rules_version = '2';

// Reglas base: nada es publico. Todo requiere sesion iniciada (Firebase Auth).
// Se iran afinando modulo por modulo (RRHH, Carga China, Bodega, Guias, Buzon).
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function miRol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return estaAutenticado() && miRol() == 'admin';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Rol de cada usuario (admin/coordinador/empleado). Cualquier usuario
    // autenticado puede leer roles (se necesita para el menu), pero solo un
    // admin puede crear o cambiar roles.
    match /usuarios/{uid} {
      allow read: if estaAutenticado();
      allow create: if esAdmin() || (estaAutenticado() && request.auth.uid == uid);
      allow update: if esAdmin();
    }

    match /empleados/{empleadoId} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado();

      // Datos sensibles (salario, etc.) solo los puede leer/escribir un
      // admin. Coordinadores y empleados no tienen acceso a esta subcoleccion.
      match /confidencial/{doc} {
        allow read, write: if esAdmin();
      }
    }

    // Vacaciones / permisos / faltas. Las registra directamente el admin
    // (no hay flujo de aprobacion); cualquier usuario autenticado puede
    // leerlas (mas adelante, cuando exista login de empleado, se limitara
    // a que cada quien vea solo lo suyo).
    match /vacaciones/{registroId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Pagos de nomina (quincenales). Mismo criterio que vacaciones.
    match /pagos/{pagoId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Marcaciones de asistencia (entrada/salida). Cualquier usuario
    // autenticado puede crear las suyas (reloj marcador de autoservicio);
    // solo un admin puede editarlas o borrarlas.
    match /asistencia/{marcaId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado();
      allow update, delete: if esAdmin();
    }
  }
}
