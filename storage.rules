rules_version = '2';

// Igual que Firestore: nada publico, todo requiere sesion iniciada.
// Se afina por carpeta (documentos de empleados, comprobantes, etc.) por modulo.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /documentos/{empleadoId}/{archivo} {
      allow read, write: if request.auth != null;
    }

    // Fotos del reloj marcador de asistencia (una por marcacion). Se borran
    // automaticamente a los 15 dias con una regla de ciclo de vida del
    // bucket (ver nota en el proyecto de Claude sobre como configurarla).
    match /asistencia/{empleadoId}/{archivo} {
      allow read, write: if request.auth != null;
    }

    // Adjuntos de Carga China: etiqueta del cliente y factura/packing
    // list/foto de cada recibo.
    match /china/{tipo}/{id}/{archivo} {
      allow read, write: if request.auth != null;
    }
  }
}
